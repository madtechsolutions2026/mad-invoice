{
  "name": "bulk-invoice-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "db:migrate": "npm run -w backend db:migrate",
    "db:seed": "npm run -w backend db:seed",
    "start:backend": "npm run -w backend dev",
    "start:worker": "npm run -w backend worker",
    "start:frontend": "npm run -w frontend dev",
    "build:backend": "npm run -w backend build",
    "build:frontend": "npm run -w frontend build"
  }
}
